# Firebase web app config for Zapp Business (web app "Zapp Business").
# Not secrets (they ship in the bundle), but per-project, so not committed.
# Copy to portal/.env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=quickpay-485417.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickpay-485417
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key for App Check, limited to the Zapp Business domain.
VITE_APPCHECK_SITE_KEY=

# Local development only. The build refuses either of these.
# VITE_USE_EMULATORS=true talks to the Auth (9099), Firestore (8080) and Functions (5001) emulators.
VITE_USE_EMULATORS=
VITE_APPCHECK_DEBUG=
