# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

# Disable prebuilt React Native core to fix @react-native-firebase static
# linking issues on RN 0.84+. The prebuilt binary uses dynamic linking which
# conflicts with Firebase's static framework requirements.
pre_install do |installer|
  ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
  ENV['RCT_USE_RN_DEP'] = '0'
end

$RNFirebaseAsStaticFramework = true

# Use static frameworks — required for Firebase Swift pods so that
# -Swift.h bridging headers are generated inside .framework bundles where
# consuming targets can find them.
use_frameworks! :linkage => :static

target 'QuickPayMerchant' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Ensure AsyncStorage native module is linked for iOS startup flags/hooks.
  pod 'RNCAsyncStorage', :path => '../node_modules/@react-native-async-storage/async-storage'

  target 'QuickPayMerchantTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Xcode 26 tightened module enforcement — disable Clang modules for RNFB
    # to avoid "declaration must be imported from module" errors.
    installer.pods_project.targets.each do |target|
      if target.name.start_with?('RNFB')
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 12.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        end

        # CLANG_ENABLE_MODULES=NO on RNFB pods disables Photos auto-linking.
        # Add Photos.framework directly to the frameworks build phase instead.
        next unless target.name == 'QuickPayMerchant'
        proj = aggregate_target.user_project
        already_linked = target.frameworks_build_phase.files.map(&:display_name)
        unless already_linked.include?('Photos.framework')
          ref = proj.frameworks_group.files.find { |f| f.path == 'Photos.framework' }
          unless ref
            ref = proj.frameworks_group.new_reference('Photos.framework')
            ref.source_tree = 'SDKROOT'
            ref.last_known_file_type = 'wrapper.framework'
          end
          target.frameworks_build_phase.add_file_reference(ref)
        end
      end
      aggregate_target.user_project.save
    end
  end
end
