{
  "name": "quickpay-merchant",
  "version": "1.0.1",
  "description": "QuickPay Merchant Mobile App",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "pod:install": "cd ios && env /usr/bin/arch -arm64 /bin/bash -lc 'export LANG=en_US.UTF-8 && RCT_USE_PREBUILT_RNCORE=0 RCT_USE_RN_DEP=0 pod install --repo-update' && cd ..",
    "pod:update": "cd ios && RCT_USE_PREBUILT_RNCORE=0 RCT_USE_RN_DEP=0 pod update && cd ..",
    "ios:clean": "cd ios && rm -rf Pods Podfile.lock && RCT_USE_PREBUILT_RNCORE=0 RCT_USE_RN_DEP=0 pod install && cd ..",
    "ios:prepare": "./scripts/prepare-ios-build.sh",
    "precommit": "npm run lint && npx tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/app-check": "^21.14.0",
    "@react-native-firebase/auth": "^21.0.0",
    "@react-native-firebase/crashlytics": "^21.14.0",
    "@react-native-firebase/firestore": "^21.0.0",
    "@react-native-firebase/functions": "^21.0.0",
    "@react-native-firebase/messaging": "^21.0.0",
    "@react-native-firebase/storage": "^21.0.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "fast-text-encoding": "^1.0.6",
    "i18next": "^26.3.1",
    "react": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "^3.9.2",
    "react-native-worklets": "^0.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.23.7",
    "@babel/runtime": "^7.23.7",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/babel-preset": "^0.85.0",
    "@react-native/eslint-config": "^0.85.0",
    "@react-native/metro-config": "^0.85.0",
    "@react-native/typescript-config": "^0.85.0",
    "@types/react": "^18.2.48",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
