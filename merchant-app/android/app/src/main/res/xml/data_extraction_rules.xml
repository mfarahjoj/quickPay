<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing from this app leaves the phone in a backup or a phone-to-phone
  transfer (Android 12+). allowBackup="false" stops cloud backup but not
  device-to-device migration, which would carry the Firebase session and
  the "PIN already checked" flags onto the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
