rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    // A signed-in app user. Zapp Business web sessions (portal/) are signed in
    // too, but read-only: they are not "authenticated" for any rule here, only
    // for isPortalFor below.
    function isAuthenticated() {
      return request.auth != null && request.auth.token.get('portal', false) != true;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection. Docs are created by Cloud Functions (setupPin) and all
    // privileged fields (accountType, kycStatus, pinHash, limits, lockout
    // counters) are function-managed — clients may only touch profile fields.
    // PIN hash, lockout counters and reset state (functions/src/auth/pinStore.ts).
    // Only Cloud Functions touch these; the phone must never see the hash.
    match /users/{userId}/private/{doc} {
      allow read, write: if false;
    }

    // Face ID public keys and their one-time challenges (auth/biometricKeys.ts).
    // Consent records (auth/acceptTerms.ts): readable by the owner, written
    // only by the server.
    match /users/{userId}/consents/{consentId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }
    // Approved phone-number changes and their history (auth/changePhone.ts).
    match /phoneChanges/{uid} {
      allow read, write: if false;
    }
    match /users/{userId}/phoneHistory/{entryId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }
    match /deviceRiskReports/{reportId} {
      allow read, write: if false;
    }
    match /biometricKeys/{keyId} {
      allow read, write: if false;
    }
    match /biometricChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if false; // Created by setupPin Cloud Function only
      // Merchants and agents can't rename themselves: customers check that
      // name before paying, so it changes only through adminRenameMerchant.
      allow update: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['fullName', 'email', 'dateOfBirth', 'gender',
                                   'address', 'preferredLanguage',
                                   'notificationPreferences', 'lastLoginAt',
                                   'updatedAt']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName']) ||
                        !(resource.data.get('accountType', 'customer') in
                          ['merchant', 'topup_agent', 'agent_merchant']));
      allow delete: if false; // Never allow user deletion from client
      
      // KYC subcollection. Read-only for the owner: submitKYC is the only
      // writer, and a client that could write here could stamp its own
      // submission `verified` or edit it after review.
      // Server-only, reads included. The ID number here is what a PIN reset
      // on an unknown phone asks for, and whoever is signed in on a stolen or
      // SIM-swapped phone is the owner as far as rules can tell. Neither app
      // reads it; the admin console goes through callables.
      match /kyc/{document=**} {
        allow read, write: if false;
      }
      
      // FCM push notification tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Wallets collection - read-only from client, updated via Cloud Functions
    match /wallets/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false; // Only Cloud Functions can modify wallets
    }
    
    // Transactions collection - read-only for involved parties
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.fromUserId) || 
                      isOwner(resource.data.toUserId));
      allow write: if false; // Only Cloud Functions can create transactions
    }
    
    // QR codes collection - merchants can read their own QR codes
    match /qrCodes/{qrCodeId} {
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.merchantId) || 
                      resource.data.status == 'active'); // Customers can read active QR codes
      allow write: if false; // Only Cloud Functions can manage QR codes
    }
    
    // Top-ups collection - users can read their own top-up requests
    match /topups/{topupId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Only Cloud Functions can process top-ups
    }
    
    // Manual top-ups collection - agents and users can read their own records
    match /manualTopups/{topupId} {
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.userId) ||
                      isOwner(resource.data.agentId));
      allow write: if false; // Only Cloud Functions can process manual top-ups
    }

    // Agent top-up requests (customer-initiated cash-in). Customer reads their
    // own request live to detect confirmation; the confirming agent can read it.
    // Zaad top-ups through agents (functions/src/zaadAgent/). The customer,
    // the agent who accepted, and the agents it is ringing on may read it.
    match /zaadAgentTopups/{requestId} {
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.customerId) ||
                      isOwner(resource.data.agentId) ||
                      isOwner(resource.data.offeredTo) ||
                      request.auth.uid in resource.data.offeredToIds);
      allow write: if false;
    }
    match /zaad_agents/{agentId} {
      allow read: if isOwner(agentId);
      allow write: if false;
    }
    match /zaad_agent_customers/{userId} {
      allow read, write: if false;
    }
    match /zaad_agent_txn_ids/{txnId} {
      allow read, write: if false;
    }
    match /zaad_agent_refs/{reference} {
      allow read, write: if false;
    }

    match /agentTopupRequests/{requestId} {
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.customerId) ||
                      isOwner(resource.data.agentId));
      allow write: if false; // Only Cloud Functions can create/confirm top-ups
    }
    
    // Settlements collection - merchants can read their own settlement requests
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && isOwner(resource.data.merchantId);
      allow write: if false; // Only Cloud Functions can process settlements
    }
    
    // Merchant profiles
    match /merchantProfiles/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      // Server-only. The business name here is what customers see when they
      // pay, so it changes through registerMerchant, role approval or
      // adminRenameMerchant, never a client. Neither app writes this doc.
      allow write: if false;
    }
    
    // Merchant insights read model (functions/src/merchantStats/,
    // MERCHANT_INSIGHTS.md): a projection of the shop's own transactions,
    // written only by the server. The shop may read its totals, customers and
    // live feed; the idempotency and first-visit markers stay server-only
    // (they match nothing here, so the default deny covers them).
    //
    // So may a live Zapp Business web session for that shop (portal/): its
    // own Firebase user `portal_{sid}` with claims {portal, portalFor,
    // portalSid}, honoured only while portalSessions/{sid} is active and
    // unexpired. Such a user's uid never equals a real user's, so every
    // isOwner() rule above already refuses it.
    function portalSession() {
      return get(/databases/$(database)/documents/portalSessions/$(request.auth.token.portalSid)).data;
    }
    // Its own shop, or a store linked to it with an active storeLinks doc
    // (functions/src/portal/groups.ts). An invite alone gives nothing.
    function isPortalFor(storeUid) {
      return request.auth != null
        && request.auth.token.get('portal', false) == true
        && request.auth.uid == 'portal_' + request.auth.token.get('portalSid', '')
        && portalSession().active == true
        && portalSession().expiresAt > request.time
        && portalSession().merchantUid == request.auth.token.get('portalFor', '')
        && (storeUid == request.auth.token.portalFor
            || (portalSession().get('actorUid', null) == null
                && get(/databases/$(database)/documents/storeLinks/$(storeUid)).data.ownerUid == request.auth.token.portalFor
                && get(/databases/$(database)/documents/storeLinks/$(storeUid)).data.status == 'active'));
    }
    function canViewStore(storeUid) {
      return (isAuthenticated() && isOwner(storeUid)) || isPortalFor(storeUid);
    }
    // A staff manager's sign-in (actorUid set, STAFF_ACCESS.md) sees only the
    // shop that granted it, never its linked stores (above), and customer
    // details only if the shop allowed it. Any change to the grant ends the
    // session (staff/manage.ts), so the session's fields are current.
    function canViewCustomers(storeUid) {
      return (isAuthenticated() && isOwner(storeUid))
        || (isPortalFor(storeUid)
            && (portalSession().get('actorUid', null) == null || portalSession().get('showCustomers', false) == true));
    }
    // Staff access (STAFF_ACCESS.md). The shop sees its staff list and each
    // staff member their own grants, to accept and to know where they work.
    // Every change goes through staff/manage.ts; the audit log is server-only.
    match /merchantStaff/{grantId} {
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.merchantUid) || isOwner(resource.data.staffUid));
      allow write: if false;
    }
    match /merchantStaffAudit/{entryId} {
      allow read, write: if false;
    }

    match /merchantStats/{storeUid} {
      allow read: if canViewStore(storeUid);
      allow write: if false;
      match /days/{day} {
        allow read: if canViewStore(storeUid);
        allow write: if false;
      }
      match /months/{month} {
        allow read: if canViewStore(storeUid);
        allow write: if false;
      }
      match /customers/{customerUid} {
        allow read: if canViewCustomers(storeUid);
        allow write: if false;
      }
      // The feed's customer names sit in their own doc, `recentNames`, so a
      // manager without "Show customers" gets the feed but not who paid.
      match /live/{docId} {
        allow read: if (docId != 'recentNames' && canViewStore(storeUid))
                    || (docId == 'recentNames' && canViewCustomers(storeUid));
        allow write: if false;
      }
    }

    // Notifications - users can read and mark as read their own notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if false; // Only Cloud Functions can create notifications
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false;
    }
    
    // Customer tokens - owner can read; any authenticated user can read active tokens (merchants scan them)
    match /customerTokens/{tokenId} {
      // Owner only. The old `status == 'active'` clause was satisfiable by a
      // query, so any signed-in user could list every live token and harvest
      // the customerId behind each one. Merchants never read these directly —
      // scanCustomerToken and createPaymentRequest go through the Admin SDK —
      // so scoping to the owner costs no flow.
      allow read: if isAuthenticated() && isOwner(resource.data.customerId);
      allow write: if false; // Only Cloud Functions can manage tokens
    }
    
    // Remittances - readable by sender or recipient
    match /remittances/{remittanceId} {
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.senderId) ||
                      isOwner(resource.data.recipientId));
      allow write: if false;
    }
    
    // Payment requests - readable by merchant or customer involved
    match /paymentRequests/{requestId} {
      // Also the staff member who raised it for the shop, so their charge
      // screen can follow it (STAFF_ACCESS.md).
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.merchantId) ||
                      isOwner(resource.data.customerId) ||
                      isOwner(resource.data.get('raisedBy', '')));
      allow write: if false; // Only Cloud Functions can manage payment requests
    }
    
    // Ledger — accounting source of truth, server-only (see LEDGER_ARCHITECTURE.md)
    match /journal_entries/{entryId} {
      allow read, write: if false;
    }
    match /ledger_balances/{account} {
      allow read, write: if false;
    }

    // Admin audit log — append-only record of every console action.
    // Server-only in both directions: admins read it through a callable, so a
    // compromised console session cannot enumerate or alter the trail that
    // would expose what it did.
    match /admin_audit/{entryId} {
      allow read, write: if false;
    }

    // Role upgrade requests (customer -> merchant/agent). Created and reviewed
    // by Cloud Functions only; a client that could write these would be back
    // to self-selecting privileged roles.
    match /roleRequests/{requestId} {
      allow read, write: if false;
    }

    // Float issuance requests. Approving one posts a journal entry that
    // credits an agent wallet, so a client that could write here could mint
    // float. Server-only, like the ledger itself.
    match /floatIssuances/{issuanceId} {
      allow read, write: if false;
    }

    // Merchant payout requests. The merchant may watch their own — the app
    // shows "requested" turning into "sent" — but every write goes through
    // requestPayout / the payout desk, which post the matching ledger entry in
    // the same transaction. A client write here would move money on its own.
    match /payoutRequests/{payoutId} {
      allow read: if isAuthenticated() && isOwner(resource.data.merchantId);
      allow write: if false;
    }

    // Trusted-device login credentials — server-only. These hold the bcrypt
    // hash of a device secret that can be exchanged (with the PIN) for a
    // session, so no client may read or write them under any circumstance.
    match /trustedDevices/{deviceId} {
      allow read, write: if false;
    }

    // Merchant Payments API (functions/src/api/). All server-only, reads
    // included. Keys are stored as hashes but still name which merchant can
    // raise charges; charges are read by customers through getApiCharge and
    // by the hosted checkout through the public endpoint, never directly.
    // Webhook endpoints hold signing secrets; deliveries and events carry
    // merchants' order data. The default deny below covers these too — they
    // are listed so nobody opens one up by accident.
    match /merchant_api_keys/{keyId} {
      allow read, write: if false;
    }
    match /api_charges/{chargeId} {
      allow read, write: if false;
    }
    match /api_refunds/{refundId} {
      allow read, write: if false;
    }
    match /api_idempotency/{recordId} {
      allow read, write: if false;
    }
    match /api_rate_limits/{bucketId} {
      allow read, write: if false;
    }
    match /api_events/{eventId} {
      allow read, write: if false;
    }
    match /webhook_endpoints/{endpointId} {
      allow read, write: if false;
    }
    match /webhook_deliveries/{deliveryId} {
      allow read, write: if false;
    }
    // Partner settings and transfers move money with no PIN. Server-only.
    match /api_partners/{merchantId}/{document=**} {
      allow read, write: if false;
    }
    match /api_transfers/{transferId} {
      allow read, write: if false;
    }
    match /api_agreements/{document=**} {
      allow read, write: if false;
    }
    // lookupRecipient's per-caller budget counters. Server-only, or a client
    // could reset its own count.
    match /recipient_lookups/{counterId} {
      allow read, write: if false;
    }
    // Ops corrections. Server-only; the console reads them through callables.
    match /adjustments/{adjustmentId} {
      allow read, write: if false;
    }
    // Ops top-ups from a float account. Server-only, like adjustments.
    match /admin_topups/{topupId} {
      allow read, write: if false;
    }
    // Disputes: the raiser and the party it's against read their own, so the
    // apps can follow the thread live. Every write is a callable (openDispute,
    // postDisputeMessage, withdrawDispute, adminResolveDispute).
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    // Minimum app versions (the apps' update gate). Public on purpose: the
    // gate runs before sign-in, and the doc holds nothing but version levels
    // and store links. Written from the console or a script, never a client.
    match /config/app_client {
      allow read: if true;
      allow write: if false;
    }

    // Counter display (functions/src/counterDisplay/, COUNTER_DISPLAY.md).
    // A shop's counter tablet has no Firebase Auth identity. It reads one
    // state doc whose id is a 256-bit secret handed to it at pairing: the id
    // is the capability, so `get` needs no sign-in and `list` is closed (ids
    // can't be enumerated). The doc holds only what the counter screen shows
    // to the public anyway: shop name, QR payloads, an amount, a first name.
    match /counterDisplayStates/{stateKey} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    // Display records (hashed secrets), pairing codes and rate counters:
    // server-only. The merchant app goes through listMyDisplays.
    match /merchantDisplays/{displayId} {
      allow read, write: if false;
    }
    match /displayPairings/{pairingId} {
      allow read, write: if false;
    }
    match /display_rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // Zapp Business web sign-ins and sessions (functions/src/portal/):
    // server-only. The rules above read a session through get().
    match /portalLogins/{loginId} {
      allow read, write: if false;
    }
    // A Zapp Business sign-in may watch its own session (never another's), so
    // an open tab leaves the moment the session ends: signed out from the
    // phone, or a staff grant changed (STAFF_ACCESS.md). Nothing secret is on it.
    match /portalSessions/{sessionId} {
      allow read: if request.auth != null
                  && request.auth.token.get('portal', false) == true
                  && request.auth.token.get('portalSid', '') == sessionId
                  && request.auth.uid == 'portal_' + sessionId;
      allow write: if false;
    }
    match /storeLinks/{storeUid} {
      allow read, write: if false;
    }

    // Bills (functions/src/bills/): server-only. Both apps list them through
    // listMyBills / merchantListBills.
    match /bills/{billId} {
      allow read, write: if false;
    }
    match /billSeries/{seriesId} {
      allow read, write: if false;
    }
    match /billAutopay/{settingId} {
      allow read, write: if false;
    }
    match /billRequests/{requestId} {
      allow read, write: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
