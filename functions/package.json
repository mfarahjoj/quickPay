{
  "name": "quickpay-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for QuickPay digital wallet system",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
