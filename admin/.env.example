# Firebase web app config for the admin console.
#
# Create a Web app under Firebase console -> Project settings -> Your apps
# (project quickpay-485417) and paste its values here as admin/.env.local.
# These are not secrets — they ship in the browser bundle — but they are
# environment-specific, so they are not committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=quickpay-485417.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickpay-485417
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key for App Check. The admin callables run with
# enforceAppCheck, so requests are rejected until this is registered for the
# admin origin under Firebase console -> App Check.
VITE_APPCHECK_SITE_KEY=

# Optional: set to "true" during local development to register an App Check
# debug token instead of reCAPTCHA. Never set this in a deployed build.
VITE_APPCHECK_DEBUG=
